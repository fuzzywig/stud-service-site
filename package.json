{
  "name": "stud-service-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate-sitemap && npm run build:client && npm run build:server && npm run copy-assets",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.js --outDir dist/server",
    "copy-assets": "cp -r dist/client/assets dist/ 2>/dev/null || xcopy dist\\client\\assets dist\\assets /s /e /i 2>nul || true",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "preview": "vite preview",
    "start": "node server.cjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "react-helmet-async": "^1.3.0",
    "firebase": "^10.7.1",
    "firebase-admin": "^12.0.0",
    "express": "^4.18.2",
    "compression": "^1.7.4",
    "vite": "^5.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "your-other-dependencies": "version"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5"
  }
}