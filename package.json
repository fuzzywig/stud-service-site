{
  "name": "stud-service-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate-sitemap && npm run build:client && npm run build:server && npm run copy-assets",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --outDir dist/server --ssr src/entry-server.jsx",
    "copy-assets": "cp -r public/* dist/client/ 2>/dev/null || xcopy public\\* dist\\client\\ /E /I /Y 2>nul || true",    "generate-sitemap": "node scripts/generate-sitemap.js",
    "sitemap:update": "node scripts/generate-sitemap.js && npm run copy-sitemap",
    "copy-sitemap": "cp public/sitemap.xml dist/client/ 2>/dev/null || copy public\\sitemap.xml dist\\client\\ 2>nul || true",
    "lint": "eslint .",
    "preview": "node server.cjs",
    "start": "node server.cjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@sendgrid/mail": "^8.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "compression": "^1.8.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "firebase": "^11.9.1",
    "firebase-admin": "^13.4.0",
    "lucide-react": "^0.509.0",
    "matrix-js-sdk": "^37.4.0",
    "mongoose": "^8.15.1",
    "node-cron": "^4.1.0",
    "react": "^18.3.1",
    "react-datepicker": "^8.3.0",
    "react-dom": "^18.3.1",
    "react-firebase-hooks": "^5.1.1",
    "react-ga4": "^2.1.0",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.5.0",
    "react-select": "^5.10.1",
    "react-slick": "^0.30.3",
    "sirv": "^3.0.1",
    "slick-carousel": "^1.8.1",
    "uuid": "^11.1.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0"
  }
}
